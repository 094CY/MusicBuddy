# MusicBuddy 配置模板
# 复制为 .env 后填写自己的值。本文件不含任何密钥，可安全提交。
# 所有 AI / 语音服务都由使用者自行选择并配置，项目不绑定任何服务商。
# 只要求接口兼容 OpenAI 的 /chat/completions 与 /audio/speech 约定。

# ===== 大语言模型（推荐、DJ 解说、对话、偏好提取）=====
# 任意兼容服务均可：自建网关、本地模型服务、或商业 API
LLM_API_KEY=
LLM_BASE_URL=
# 模型名。留空时自动从 {LLM_BASE_URL}/models 探测第一个可用模型
LLM_MODEL=
# 可选：按任务分别指定模型，未填则回退到 LLM_MODEL
# LLM_MODEL_RECOMMEND=
# LLM_MODEL_CHAT=
# LLM_MODEL_DJ=
# LLM_MODEL_EXTRACT=

# ===== 语音合成（DJ 播报，可选）=====
# 不配置时 DJ 播报自动关闭，不影响播放与搜索
# 方式一：通用 HTTP 接口（推荐），实现 /audio/speech
TTS_PROVIDER=openai-compatible
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=
TTS_VOICE=
# 方式二：使用可选 SDK 适配器，设为 sdk 后填写下列凭据
# TTS_PROVIDER=sdk
# TTS_SECRET_ID=
# TTS_SECRET_KEY=
# TTS_REGION=
# TTS_VOICE_TYPE=
# TTS_VOICE_FALLBACK=
# 完全关闭：TTS_PROVIDER=none

# ===== 音源（可选）=====
# 部分网页音源需要使用者自行提供公开接口标识；留空则该音源自动降级
YTMUSIC_API_KEY=

# ===== 服务 =====
BACKEND_PORT=3721

# ===== 公网部署（可选，本机 / 桌面使用留空）=====
# 启用后 /api/ai 与 /api/tts 需携带 x-access-password 请求头
ACCESS_PASSWORD=
# CORS 白名单，逗号分隔
ALLOWED_ORIGINS=
# 可信反向代理 IP。仅此列表内的代理才采信 x-forwarded-for
TRUSTED_PROXY=

# ===== 限流（可选，默认值适合个人使用）=====
AI_RATE_MAX=60
LIGHT_RATE_MAX=600
TTS_RATE_MAX=120

# ===== 桌面端内部使用（无需手动配置）=====
# DOTENV_PATH：由主进程注入，指向用户数据目录下的 .env
